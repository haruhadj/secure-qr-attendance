#############################################
# .ENV EXAMPLE FILE
# IMPORTANT: DO NOT commit this file to Git! 
# Replace all '<YOUR_VALUE>' placeholders with your actual credentials.
#############################################


# ============================================
# 🔑 NEXTAUTH / AUTHENTICATION CONFIGURATION
# ============================================

# The secret key for NextAuth (must be a long, random string)
NEXTAUTH_SECRET="<generate-a-long-random-string>"

# The base URL of your application (e.g., http://localhost:3000 or https://yourdomain.com)
NEXTAUTH_URL="http://localhost:3000"


# ============================================
# 💾 PRIMARY DATABASE CONNECTION STRINGS
# Choose ONE method/group based on your ORM/Framework's requirement.
# ============================================

# Recommended connection string (Standard URL format for pooling/modern setups)
# Format: postgresql://user:password@host:port/database?options
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<HOST>:<PORT>/<DBNAME>?sslmode=require

# Optional: Alternative connection string for uses requiring non-pooled connections
DATABASE_URL_UNPOOLED=postgresql://<DB_USER>:<DB_PASSWORD>@<HOST>:<PORT>/<DBNAME>?sslmode=require

# Email (Resend) — required for self-service password reset
# Sign up at https://resend.com, get a free API key, and verify your sending domain.
RESEND_API_KEY="<YOUR_RESEND_API_KEY>"
RESEND_FROM_EMAIL="<YOUR_RESEND_FROM_EMAIL>"

# ============================================
# ⚙️ INDIVIDUAL DATABASE PARAMETERS (Alternative)
# Use these if your framework prefers separate variables over a single URL.
# ============================================

PGHOST=<YOUR_DATABASE_HOST>
PGUSER=<YOUR_DB_USERNAME>
PGPASSWORD=<YOUR_DB_PASSWORD>
PGDATABASE=<YOUR_DB_NAME>


# ============================================
# 💡 VERCEL / PRISMA TEMPLATE VARIABLES (If applicable)
# These are often required by specific ORMs or deployment templates.
# Use the set that matches your project configuration.
# ============================================

# General URL for pooled connections
POSTGRES_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<HOST>/<DBNAME>?sslmode=require

# Specific variable often used by Prisma/Vercel setup
POSTGRES_PRISMA_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<HOST>/<DBNAME>?sslmode=require
