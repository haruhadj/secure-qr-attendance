{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && prisma migrate deploy && next build",
  "crons": [
    {
      "path": "/api/cron/backup",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/cron/mark-absent",
      "schedule": "*/5 * * * *"
    }
  ]
}
